ARG NODE_JS_IMAGE_VERSION=24-alpine
ARG BUILD_TYPE=production

FROM node:${NODE_JS_IMAGE_VERSION} AS build
ARG BUILD_TYPE
ARG WALLET_CONNECT_PROJECT_ID=
ENV WALLET_CONNECT_PROJECT_ID=${WALLET_CONNECT_PROJECT_ID}

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

ADD . /project
WORKDIR /project

RUN corepack enable && \
    corepack prepare pnpm@11.4.0 --activate

RUN pnpm install --frozen-lockfile

RUN if [ "$BUILD_TYPE" = "development" ]; then \
        pnpm build:staging && pnpm postbuild:staging; \
    else\
        pnpm build && pnpm postbuild; \
    fi

FROM nginx:stable-alpine

WORKDIR /usr/share/nginx/html

COPY --from=build /project/release/build .

RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
