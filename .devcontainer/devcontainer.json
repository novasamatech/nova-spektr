{
  "name": "Nova Spektr",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "runArgs": [
    "--name",
    "nova-spektr-dev"
  ],
  "mounts": [
    "source=${localEnv:HOME}/Library/Application Support/mkcert,target=/home/node/.mkcert-host,type=bind,readonly"
  ],
  "containerEnv": {
    "CAROOT": "/home/node/.mkcert-host"
  },
  "forwardPorts": [
    3000,
    6006
  ],
  "portsAttributes": {
    "3000": {
      "label": "Renderer Dev Server",
      "onAutoForward": "notify",
      "protocol": "https"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install -g pnpm@11.4.0 && pnpm install",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
